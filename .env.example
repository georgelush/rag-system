# rag-example — copy this file to .env and fill in your values

# ── Auth ───────────────────────────────────────────────────────────────────────
# Bearer token callers must send in the Authorization header
RAG_API_KEY=change-me

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_API_KEY=
LLM_PROXY=
LLM_MODEL=gpt-5.4-nano
EMBEDDING_MODEL=text-embedding-3-small

# ── Infrastructure ─────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379

# ── Optional ───────────────────────────────────────────────────────────────────
# RAG_PORT=8080
# RAG_VERSION=1.0.0
# WEBHOOK_SECRET=          # HMAC-SHA256 secret for callback signatures (exchanged out of band with caller)

# ── Observability (Langfuse) ────────────────────────────────────────────────────
# Leave blank to disable tracing (no-op mode, no error thrown)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Rate Limiting (requests per minute per tenant) ─────────────────────────────
RATE_LIMIT_QUERY=60
RATE_LIMIT_INGEST=20
RATE_LIMIT_DEFAULT=120

# ── Worker ─────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
WORKER_MAX_RETRIES=3      # retry failed jobs this many times before moving to DLQ
WORKER_RETRY_DELAY_S=5    # base delay (seconds) for exponential backoff (5, 10, 20 …)
WHISPER_MODEL=whisper-1

# ── Query Cache ─────────────────────────────────────────────────────────────────
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL_S=300     # seconds; cache is invalidated automatically on re-ingest

# ── Metrics ─────────────────────────────────────────────────────────────────────
METRICS_ENABLED=true      # expose GET /metrics in Prometheus text format
# ── Reranker sidecar (optional) ─────────────────────────────────────────────────────────────
# When set, POST /v1/query and /v1/query/stream call this URL for reranking
# Leave blank to skip reranking (rerank:true in the request has no effect)
RERANKER_URL=             # e.g. http://localhost:8090  or  http://reranker:8090

# ── Namespace-level RBAC (optional) ───────────────────────────────────────────────────────
# Set to true to enable JWT namespace-scoped tokens alongside the master key
RBAC_ENABLED=false
# HS256 signing secret for JWT namespace tokens; required when RBAC_ENABLED=true
RBAC_SECRET=              # generate with: python -c "import secrets; print(secrets.token_hex(32))"

# ── Session D — Performance & Resilience tuning ────────────────────────────────
# Chunks per OpenAI embeddings.create() call (max 2048; default 500)
EMBED_BATCH_SIZE=500
# HTTP timeout (seconds) for cross-encoder reranker sidecar calls
RERANKER_TIMEOUT_S=10.0
# TTL (seconds) for GET /v1/namespaces/{id}/stats Redis cache; set 0 to disable
STATS_CACHE_TTL_S=60
# Maximum parallel queries accepted in POST /v1/query/batch
BATCH_QUERY_MAX=10
# Max seconds to wait for in-flight jobs during graceful worker shutdown
WORKER_SHUTDOWN_TIMEOUT_S=30
